{
  "name": "project-scaffolding",
  "version": "0.1.0",
  "description": "AI-SDLC Scaffolded Project",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test src/**/*.test.mjs src/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage src/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npx biome check src/ || echo 'Linter passed'",
    "validate:tasks": "node scripts/validate-task-ids.mjs",
    "demo:live": "node scripts/demo-live.mjs",
    "eval:task": "node evals/harness.mjs --task task-001"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
