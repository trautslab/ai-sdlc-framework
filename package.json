{
  "name": "ai-sdlc-framework",
  "version": "1.7.0",
  "description": "AI-SDLC Starter Kit & Agentic-Native Framework with 3-Layer Governance, Multi-Cloud Deployment & RSI",
  "type": "module",
  "scripts": {
    "test": "npm run precommit:audit && npm run demo:test && npm run rsi:suite",
    "dashboard": "node templates/scripts/serve-dashboard.mjs --open",
    "precommit:audit": "node templates/scripts/pre-commit-guard.mjs",
    "rsi:suite": "node templates/scripts/rsi/run-rsi-suite.mjs --pattern all",
    "rsi:perf": "node templates/scripts/rsi/auto-perf-loop.mjs",
    "rsi:adversarial": "node templates/scripts/rsi/adversarial-fuzzer.mjs",
    "rsi:drift": "node templates/scripts/rsi/arch-drift-guard.mjs",
    "rsi:frugal": "node templates/scripts/rsi/frugal-compactor.mjs",
    "rsi:swebench": "node templates/scripts/rsi/micro-swebench.mjs",
    "rsi:adr": "node templates/scripts/rsi/living-adr-sync.mjs",
    "demo:test": "cd demos/shopfast-ecommerce-ai-sdlc && npm test",
    "demo:live": "cd demos/shopfast-ecommerce-ai-sdlc && npm run demo:live",
    "simulate:live": "cd demos/shopfast-ecommerce-ai-sdlc && npm run simulate:live"
  },
  "keywords": ["ai-sdlc", "rsi", "agentic-native", "dual-rail", "swe-bench", "metr", "evals", "multi-cloud", "finops"],
  "author": "TraustLab & Antigravity AI",
  "license": "MIT"
}
